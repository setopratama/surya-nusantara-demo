                            <span class="q-table-subtext text-xs text-muted">
                              {q.options.length} Opsi • {q.explanation ? (q.explanation.length > 70 ? q.explanation.slice(0, 70) + '...' : q.explanation) : ''}
                            </span>
                          </td>
                          <td>
                            <span class={`q-badge ${pBadgeClass}`}>{pLabel}</span>
                          </td>
                          <td>
                            <span class={`q-badge ${poolBadgeClass}`}>{poolLabel}</span>
                          </td>
                          <td>
                            <span class={`q-diff-badge ${diffBadgeClass}`}>{difficulty.toUpperCase()}</span>
                          </td>
                          <td style="text-align: center;">
                            <span class="q-key-pill font-mono" title={`Kunci Jawaban: ${correctOpt ? correctOpt.text : q.correctOptionId}`}>
