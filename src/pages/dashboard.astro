  .status-optimal { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
  .status-review { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

  /* =========================================================
     MODAL FORM INPUT & EDIT SOAL STYLING
     ========================================================= */
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 23, 42, 0.45);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(4px);
  }

  .modal-container {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-xl);
    width: 100%;
    max-width: 960px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  .modal-header {
    padding: 1.15rem 1.5rem;
    border-bottom: 1px solid var(--dash-border);
    background: #f8fafc;
