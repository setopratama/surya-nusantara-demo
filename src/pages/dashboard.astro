        const inputQuestion = document.getElementById('f-question-text') as HTMLTextAreaElement | null;
        const selectCategory = document.getElementById('f-category') as HTMLSelectElement | null;
        const selectPool = document.getElementById('f-pool') as HTMLSelectElement | null;
        const selectDiff = document.getElementById('f-difficulty') as HTMLSelectElement | null;
        const inputOptA = document.getElementById('f-opt-a') as HTMLInputElement | null;
        const inputOptB = document.getElementById('f-opt-b') as HTMLInputElement | null;
        const inputOptC = document.getElementById('f-opt-c') as HTMLInputElement | null;
