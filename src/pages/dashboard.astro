    min-width: 0;
  }

  .modal-title-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .modal-title {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--dash-text-main);
    margin: 0;
    line-height: 1.3;
  }

  .modal-id-badge {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--dash-text-muted);
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    letter-spacing: 0.02em;
  }

  .modal-subtitle {
    font-size: 0.76rem;
    color: var(--dash-text-muted);
    display: block;
    margin: 4px 0 0 0;
    line-height: 1.45;
  }

  .btn-modal-close {
    background: none;
    border: none;
    color: var(--dash-text-muted);
    cursor: pointer;
    padding: 6px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.12s ease;
  }

  .btn-modal-close:hover {
    color: #ef4444;
    background: #fef2f2;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    flex: 1;
  }

  .modal-form-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
  }

  .form-row-multi {
    display: flex;
    gap: 0.75rem;
  }

  .flex-1 { flex: 1; }

  .input-text-dash {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-md);
    background: #ffffff;
    font-size: 0.82rem;
    font-family: var(--font-body);
    color: var(--dash-text-main);
    outline: none;
    transition: border-color 0.15s ease;
  }

  .input-text-dash:focus {
    border-color: var(--dash-gold);
    box-shadow: 0 0 0 3px rgba(150, 113, 38, 0.12);
  }

  .textarea-dash,
  .input-textarea-dash {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-md);
    background: #ffffff;
    font-size: 0.82rem;
    font-family: var(--font-body);
    color: var(--dash-text-main);
