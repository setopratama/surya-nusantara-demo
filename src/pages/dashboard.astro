      // ─────────────────────────────────────────
      // Distribusi Soal & Quiz Builder Controls
      // ─────────────────────────────────────────
      function initDistribusiManagement() {
        const rows = document.querySelectorAll<HTMLElement>('.dist-row');
        const filterBtns = document.querySelectorAll<HTMLButtonElement>('.dist-filter-btn');
        const searchInput = document.getElementById('input-search-dist') as HTMLInputElement | null;
        const emptyRow = document.getElementById('dist-empty-row');
        let currentFilter = 'all';

        function applyDistFilters() {
          const query = (searchInput?.value || '').trim().toLowerCase();
          let visibleCount = 0;

          rows.forEach((row) => {
            const status = row.dataset.status || '';
            const searchText = row.dataset.searchText || '';

            const matchesStatus = currentFilter === 'all' || status === currentFilter;
            const matchesSearch = !query || searchText.includes(query);

            if (matchesStatus && matchesSearch) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          if (emptyRow) {
            emptyRow.style.display = visibleCount === 0 ? '' : 'none';
          }
        }

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.dataset.distFilter || 'all';
            applyDistFilters();
          });
        });

        searchInput?.addEventListener('input', applyDistFilters);

        // Copy URL Buttons on cards
        document.querySelectorAll('.btn-copy-url').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const raw = (btn as HTMLElement).dataset.copyUrl || '/';
            const url = raw.startsWith('http') ? raw : `${window.location.origin}${raw}`;
            if (url) {
              try {
                await navigator.clipboard.writeText(url);
                showToast(`Tautan berhasil disalin: ${url}`);
              } catch (e) {
                showToast(`Tautan: ${url}`);
              }
            }
          });
        });

        // QR Code Modal Preview & Download
        const modalQr = document.getElementById('modal-qr-preview');
        const closeQrModal = () => { if (modalQr) modalQr.style.display = 'none'; };
        document.getElementById('btn-close-qr-modal')?.addEventListener('click', closeQrModal);
        document.getElementById('btn-close-qr-preview-footer')?.addEventListener('click', closeQrModal);

        document.querySelectorAll('.btn-open-qr-modal').forEach((btn) => {
          btn.addEventListener('click', () => {
            const el = btn as HTMLElement;
            const distId = el.dataset.distId || 'DIST-01';
            const distName = el.dataset.distName || 'Distribusi Kuis';
            const distDates = el.dataset.distDates || '-';
            const rawUrl = el.dataset.distUrl || `/?dist=${distId}`;
            const distUrl = rawUrl.startsWith('http') ? rawUrl : `${window.location.origin}${rawUrl}`;

            const idEl = document.getElementById('qr-modal-id');
            const subEl = document.getElementById('qr-modal-subtitle');
            const datesEl = document.getElementById('qr-modal-dates');
            const inputEl = document.getElementById('qr-modal-url-input') as HTMLInputElement | null;

            if (idEl) idEl.textContent = distId;
            if (subEl) subEl.textContent = distName;
            if (datesEl) datesEl.textContent = distDates;
            if (inputEl) inputEl.value = distUrl;

            if (modalQr) modalQr.style.display = 'flex';
          });
        });

        // Copy URL from inside QR Modal
        document.getElementById('btn-copy-modal-url')?.addEventListener('click', async () => {
          const inputEl = document.getElementById('qr-modal-url-input') as HTMLInputElement | null;
          if (inputEl?.value) {
            try {
              await navigator.clipboard.writeText(inputEl.value);
              showToast('Tautan akses berhasil disalin.');
            } catch (e) {
              showToast(`Tautan: ${inputEl.value}`);
            }
          }
        });

        // Download SVG file
        document.getElementById('btn-download-qr-svg')?.addEventListener('click', () => {
          const svgEl = document.getElementById('qr-modal-svg');
          const idEl = document.getElementById('qr-modal-id');
          const distId = idEl?.textContent || 'KUIS';
          if (svgEl) {
            const svgData = new XMLSerializer().serializeToString(svgEl);
            const svgBlob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
            const svgUrl = URL.createObjectURL(svgBlob);
            const downloadLink = document.createElement('a');
            downloadLink.href = svgUrl;
            downloadLink.download = `QR_${distId}.svg`;
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
            URL.revokeObjectURL(svgUrl);
            showToast(`File QR_${distId}.svg berhasil diunduh.`);
          }
        });

        // 8-Step Quiz Builder Wizard
        const modalCreateDist = document.getElementById('modal-create-dist');
        const btnOpenCreate = document.getElementById('btn-open-create-dist');
        const btnCloseCreate = document.getElementById('btn-close-create-dist');
        const btnCancelCreate = document.getElementById('btn-cancel-dist-wizard');
        const btnPrev = document.getElementById('btn-wizard-prev') as HTMLButtonElement | null;
        const btnNext = document.getElementById('btn-wizard-next') as HTMLButtonElement | null;
        const stepNodes = document.querySelectorAll('.wizard-step-node');
        const panes = document.querySelectorAll('.wizard-pane');
        let currentStep = 1;
        const totalSteps = 8;

        function updateStepUI() {
          // Update Stepper Nodes
          stepNodes.forEach((node) => {
            const s = parseInt((node as HTMLElement).dataset.step || '1', 10);
            node.classList.remove('active', 'completed');
            if (s === currentStep) {
              node.classList.add('active');
            } else if (s < currentStep) {
              node.classList.add('completed');
            }
          });

          // Show targeted pane
          panes.forEach((pane) => {
            if (pane.id === `pane-step-${currentStep}`) {
              (pane as HTMLElement).style.display = 'block';
            } else {
              (pane as HTMLElement).style.display = 'none';
            }
          });

          // Update Prev/Next button states
          if (btnPrev) {
            btnPrev.disabled = currentStep === 1;
          }

          if (btnNext) {
            if (currentStep === totalSteps) {
              btnNext.innerHTML = `
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Simpan & Terbitkan Distribusi</span>
              `;
            } else {
              btnNext.innerHTML = `
                <span>Selanjutnya</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              `;
            }
          }
        }

        btnOpenCreate?.addEventListener('click', () => {
          currentStep = 1;
          updateStepUI();
          if (modalCreateDist) modalCreateDist.style.display = 'flex';
        });

        const closeWizard = () => {
          if (modalCreateDist) modalCreateDist.style.display = 'none';
        };

        btnCloseCreate?.addEventListener('click', closeWizard);
        btnCancelCreate?.addEventListener('click', closeWizard);

        btnPrev?.addEventListener('click', () => {
          if (currentStep > 1) {
            currentStep--;
            updateStepUI();
          }
        });

        btnNext?.addEventListener('click', () => {
          if (currentStep < totalSteps) {
            currentStep++;
            updateStepUI();
          } else {
            // Final Publish
            const distNameInput = document.getElementById('wiz-dist-name') as HTMLInputElement | null;
            const name = distNameInput?.value.trim() || 'Distribusi Kuis Baru';
            closeWizard();
            showToast(`Distribusi "${name}" berhasil diterbitkan lengkap dengan QR Code unik!`);
          }
        });

        // Click on step node directly to jump to previously visited steps
        stepNodes.forEach((node) => {
          node.addEventListener('click', () => {
            const target = parseInt((node as HTMLElement).dataset.step || '1', 10);
            if (target <= currentStep || target === currentStep + 1) {
              currentStep = target;
              updateStepUI();
            }
          });
        });
      }

      // Bootstrap all features
      document.addEventListener('DOMContentLoaded', () => {
        initTabNavigation();
        initBankSoalFilter();
        initQuestionFormModal();
        initCategoryManagement();
        initDistribusiManagement();
        loadDashboard();
      });
    </script>
  </body>
</html>

