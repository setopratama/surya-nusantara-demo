  .qb-src-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Set Size Card */
  .set-size-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .set-size-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: #ffffff;
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-md);
    padding: 16px;
  }

  .set-size-icon {
    width: 44px;
    height: 44px;
    background: var(--dash-gold-light);
    border: 1px solid var(--dash-gold-border);
