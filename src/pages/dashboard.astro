  }

  /* Custom Checkbox Row */
  .custom-checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-md);
