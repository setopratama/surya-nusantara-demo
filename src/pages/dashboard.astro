                      const poolBadgeClass = q.isBrandPool ? 'badge-pool-brand' : 'badge-pool-general';
                      const pBadgeClass = pillarBadges[q.category] || 'badge-pillar-craft';
                      const pLabel = pillarLabels[q.category] || q.category;

                      // Synthetic difficulty classification
                      const difficulty = idx % 3 === 0 ? 'mudah' : idx % 3 === 1 ? 'sedang' : 'sulit';
                      const diffBadgeClass = difficulty === 'mudah' ? 'diff-easy' : difficulty === 'sedang' ? 'diff-mid' : 'diff-hard';
                      const correctOpt = q.options.find(o => o.id === q.correctOptionId);

                      return (
                        <tr
                          class="question-admin-row"
                          data-id={q.id}
                          data-pool={poolType}
                          data-category={q.category}
                          data-difficulty={difficulty}
                          data-text={`${q.id} ${q.text} ${q.options.map(o => o.text).join(' ')}`.toLowerCase()}
