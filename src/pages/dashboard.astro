          if (inputBrandMessage) inputBrandMessage.value = '';

          // Reset preview tab to quiz
          tabPrevQuiz?.click();

          updatePreview();
          if (modal) modal.style.display = 'flex';
        });

        // Close modal handlers
        function closeModal() {
          if (modal) modal.style.display = 'none';
        }

        btnClose?.addEventListener('click', closeModal);
        btnCancel?.addEventListener('click', closeModal);

        // Save actions
        document.getElementById('btn-save-soal')?.addEventListener('click', () => {
