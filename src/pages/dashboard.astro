<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <title>Dashboard Analitik & Manajemen Soal — Surya Nusantara</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@600;700&family=Roboto+Condensed:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <div class="dashboard-wrapper">
      <!-- Top Slim Header (Cloudflare / GCP Style) -->
      <header class="dash-header">
        <div class="dash-header-inner">
          <div class="dash-brand">
            <button id="btn-sidebar-toggle" class="btn-sidebar-toggle" aria-label="Toggle Menu" title="Toggle Navigasi">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
            <a href="/dashboard#overview" class="brand-link" title="Dashboard Surya Nusantara">
              <img
                src="/assets/logo_gold.png"
                alt="Surya Nusantara"
                class="dash-logo"
                width="1536"
                height="1024"
              />
            </a>
          </div>

          <div class="dash-actions">
            <button id="btn-seed" class="btn-dash-action" title="Isi data simulasi untuk presentasi demo">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              </svg>
              <span>Mock Data</span>
            </button>
            <button id="btn-refresh" class="btn-dash-action" title="Perbarui data">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
              </svg>
              <span>Refresh</span>
            </button>
            <a href="/" class="btn-dash-primary" target="_blank" rel="noopener">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>Buka Kuis</span>
            </a>
          </div>
        </div>
      </header>

      <!-- Main Layout Body: Left Sidebar + Content Area -->
      <div class="dash-layout">
        <!-- Left Sidebar Navigation -->
        <aside id="dash-sidebar" class="dash-sidebar">
          <div class="sidebar-content">
            <!-- Section: Navigasi Utama -->
            <div class="sidebar-section">
              <span class="sidebar-heading">NAVIGASI UTAMA</span>
              <nav class="sidebar-nav">
                <a href="#overview" class="sidebar-item active" data-tab="overview">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                  </svg>
                  <span>Dashboard Ringkasan</span>
                </a>
              </nav>
            </div>

            <!-- Section: Manajemen Soal -->
            <div class="sidebar-section">
              <span class="sidebar-heading">MANAJEMEN SOAL</span>
              <nav class="sidebar-nav">
                <a href="#bank-soal" class="sidebar-item" data-tab="bank-soal">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                  </svg>
                  <span>Bank Soal</span>
                  <span class="sidebar-badge">{QUESTIONS_BANK.length}</span>
                </a>
                <a href="#kategori-soal" class="sidebar-item" data-tab="kategori-soal">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                  </svg>
                  <span>Kategori Soal</span>
                  <span class="sidebar-badge">{CATEGORIES_DATA.length}</span>
                </a>
                <a href="#distribusi-soal" class="sidebar-item" data-tab="distribusi-soal">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                    <path d="M14 14h3v3h-3z"></path>
                    <path d="M20 14v3"></path>
                    <path d="M14 20h3"></path>
                    <path d="M20 20v.01"></path>
                  </svg>
                  <span>Distribusi Soal</span>
                  <span class="sidebar-badge">{DISTRIBUTIONS_DATA.length}</span>
                </a>
                <a href="/dashboard/peserta" class="sidebar-item">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  <span>Data Peserta</span>
                  <span class="sidebar-badge">{DEMO_OVERVIEW_STATS.totalParticipants}</span>
                </a>
                <a href="#analitik-soal" class="sidebar-item" data-tab="analitik-soal">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                  <span>Analitik Performa Soal</span>
                </a>
              </nav>
            </div>

            <!-- Section: Sistem & Laporan -->
            <div class="sidebar-section">
              <span class="sidebar-heading">SISTEM & LAPORAN</span>
              <nav class="sidebar-nav">
                <a href="#laporan" class="sidebar-item nav-placeholder" data-menu="Laporan & Ekspor">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 11 12 14 22 4"></polyline>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                  </svg>
                  <span>Laporan & Ekspor</span>
                </a>
                <a href="#settings" class="sidebar-item nav-placeholder" data-menu="Pengaturan Sistem">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                  </svg>
                  <span>Pengaturan</span>
                </a>
              </nav>
            </div>
          </div>
        </aside>

        <!-- Right Main Dashboard Container -->
        <main class="dash-main">
          <!-- Notification toast -->
          <div id="dash-toast" class="dash-toast" style="display: none;"></div>

          <!-- ============================================================== -->
          <!-- TAB 1: OVERVIEW / RINGKASAN AKTIVITAS                          -->
          <!-- ============================================================== -->
          <div id="view-overview" class="dash-view active">
            <!-- Section Title Bar -->
            <div class="dash-section-header">
              <div>
                <h1 class="dash-page-title">Ringkasan Aktivitas Kuis</h1>
                <span class="dash-page-subtitle">Metrik performa engagement dan aktivitas peserta realtime</span>
              </div>
            </div>

            <!-- Row 1: KPI Summary Cards -->
            <section class="kpi-grid">
              <div class="kpi-card">
                <div class="kpi-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                </div>
                <div class="kpi-data">
                  <span class="kpi-label">Total Peserta Registrasi</span>
                  <span id="kpi-participants" class="kpi-value tabular-nums">{DEMO_OVERVIEW_STATS.totalParticipants.toLocaleString('id-ID')}</span>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                  </svg>
                </div>
                <div class="kpi-data">
                  <span class="kpi-label">Sesi Kuis Selesai</span>
                  <span id="kpi-completed" class="kpi-value tabular-nums">{DEMO_OVERVIEW_STATS.totalCompleted.toLocaleString('id-ID')}</span>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="7"></circle>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                  </svg>
                </div>
                <div class="kpi-data">
                  <span class="kpi-label">Rata-rata Skor</span>
                  <span id="kpi-avg-score" class="kpi-value tabular-nums">{DEMO_OVERVIEW_STATS.averageScore}<span class="kpi-unit">/100</span></span>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                </div>
                <div class="kpi-data">
                  <span class="kpi-label">Skor Tertinggi</span>
                  <span id="kpi-max-score" class="kpi-value tabular-nums">{DEMO_OVERVIEW_STATS.maxScore}<span class="kpi-unit">/100</span></span>
                </div>
              </div>
