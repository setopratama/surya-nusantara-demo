      // ─────────────────────────────────────────
      // Realtime Stats & Overview Table Loader
      // ─────────────────────────────────────────
      async function loadDashboard() {
        try {
          // Fetch stats
          const statsRes = await fetch('/api/stats');
          if (statsRes.ok) {
            const data = await statsRes.json();
            if (data?.success && data?.stats) {
              renderStats(data.stats);
            }
          }

          // Fetch participants table
          const partRes = await fetch('/api/participants');
          if (partRes.ok) {
            const data = await partRes.json();
            if (data?.success && Array.isArray(data?.participants) && data.participants.length > 0) {
              renderTable(data.participants);
            }
          }
        } catch (err) {
          console.warn('Dashboard fetch offline/error:', err);
        }
      }

      function renderStats(stats: any) {
        if (!stats) return;
        const setTxt = (id: string, val: string | number) => {
          const el = document.getElementById(id);
          if (el) el.textContent = String(val);
        };

        if (stats.totalParticipants !== undefined) setTxt('kpi-participants', stats.totalParticipants);
        if (stats.totalCompleted !== undefined) setTxt('kpi-completed', stats.totalCompleted);
        if (stats.averageScore !== undefined) setTxt('kpi-avg-score', stats.averageScore);
        if (stats.maxScore !== undefined) setTxt('kpi-max-score', stats.maxScore);

        // Render Score distribution
        const dist = stats.scoreDistribution;
        if (dist) {
          const maxBucket = Math.max(
            1,
            dist['81-100'] || 0,
            dist['61-80'] || 0,
            dist['41-60'] || 0,
            dist['21-40'] || 0,
            dist['0-20'] || 0
          );

          const updateBar = (barId: string, countId: string, count: number) => {
            const bar = document.getElementById(barId);
            const countEl = document.getElementById(countId);
            if (countEl) countEl.textContent = String(count);
            if (bar) {
              const pct = Math.round((count / maxBucket) * 100);
              bar.style.width = `${Math.max(4, pct)}%`;
            }
          };

          updateBar('bar-81-100', 'count-81-100', dist['81-100'] || 0);
          updateBar('bar-61-80', 'count-61-80', dist['61-80'] || 0);
          updateBar('bar-41-60', 'count-41-60', dist['41-60'] || 0);
          updateBar('bar-21-40', 'count-21-40', dist['21-40'] || 0);
          updateBar('bar-0-20', 'count-0-20', dist['0-20'] || 0);
        }

        // Render Top Cities
        const citiesList = document.getElementById('cities-list');
        if (citiesList && Array.isArray(stats.topCities) && stats.topCities.length > 0) {
          const maxCityCount = stats.topCities[0]?.count || 1;
          citiesList.innerHTML = stats.topCities
            .map((c: any) => {
              const pct = c.percentage !== undefined ? c.percentage : Math.round((c.count / maxCityCount) * 100);
              return `
                <div class="city-row">
                  <span class="city-name">${c.domicile}</span>
                  <div class="city-track">
                    <div class="city-fill" style="width: ${pct}%;"></div>
                  </div>
                  <span class="city-count tabular-nums">${c.count} orang</span>
                </div>
              `;
            })
            .join('');
        }
      }

      function renderTable(rows: any[]) {
        const tbody = document.getElementById('participants-tbody');
        if (!tbody) return;

        if (!rows || rows.length === 0) {
          if (tbody.children.length > 0) return;
          tbody.innerHTML = `
            <tr>
              <td colspan="7" class="empty-table-cell">
                Belum ada data peserta yang tersimpan. Klik <strong>"+ Mock Data"</strong> untuk mengisi simulasi kuis.
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = rows
          .map((r) => {
            const score = r.totalScore ?? r.score ?? 0;
            const scoreBadgeClass =
              score >= 80 ? 'score-high' : score >= 60 ? 'score-mid' : score >= 40 ? 'score-fair' : 'score-low';

            const timeStr =
              r.time ||
              (r.createdAt
                ? new Date(r.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) +
                  ', ' +
                  new Date(r.createdAt).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) +
                  ' WIB'
                : '10 Nov 2026, 13:18 WIB');

            return `
              <tr>
                <td class="tabular-nums text-muted">${timeStr}</td>
                <td class="font-bold text-display">${r.name}</td>
                <td><span class="age-chip">${r.ageBand}</span></td>
                <td>${r.domicile}</td>
                <td class="text-muted text-sm">${r.occupation}</td>
                <td><span class="brand-chip">${r.currentBrand}</span></td>
                <td><span class="score-pill ${scoreBadgeClass}">${score} poin</span></td>
              </tr>
            `;
          })
          .join('');
      }

