          activeDiff = (e.target as HTMLSelectElement).value;
          applyFilters();
        });
      }

      // ─────────────────────────────────────────
      // Modal Input Form & Live Preview
      // ─────────────────────────────────────────
      function initQuestionFormModal() {
        const modal = document.getElementById('modal-form-soal');
        const btnOpen = document.getElementById('btn-open-create-modal');
        const btnClose = document.getElementById('btn-close-modal');
        const btnCancel = document.getElementById('btn-cancel-modal');
