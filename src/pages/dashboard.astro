    font-family: var(--font-mono);
  }

  .qb-source-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .qb-source-card {
    background: #ffffff;
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
