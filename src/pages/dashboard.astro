    <!-- Client Script for Tab Navigation, Search/Filter, Modal, and Realtime Preview -->
    <script>
      // ─────────────────────────────────────────
      // Tab Navigation & Hash Routing
      // ─────────────────────────────────────────
      function initTabNavigation() {
        const tabs = document.querySelectorAll<HTMLAnchorElement>('.sidebar-item[data-tab]');
        const views = document.querySelectorAll<HTMLElement>('.dash-view');
        const crumb = document.getElementById('header-crumb');

        const tabTitles: Record<string, string> = {
          overview: 'Kuis Dedikasi Di Balik Rasa',
          'bank-soal': 'Manajemen Bank Soal',
          'kategori-soal': 'Kategori & Pilar Soal',
          'distribusi-soal': 'Distribusi Soal',
          'analitik-soal': 'Analitik Performa Soal',
        };

        function switchTab(targetTab: string) {
          // Update sidebar links
          tabs.forEach((tab) => {
            if (tab.dataset.tab === targetTab) {
              tab.classList.add('active');
            } else {
              tab.classList.remove('active');
            }
          });

          // Show targeted view
          views.forEach((view) => {
            if (view.id === `view-${targetTab}`) {
              view.style.display = 'block';
            } else {
              view.style.display = 'none';
            }
          });

          // Update breadcrumb
          if (crumb && tabTitles[targetTab]) {
            crumb.textContent = tabTitles[targetTab];
          }

          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Attach click listener to sidebar tabs
        tabs.forEach((tab) => {
          tab.addEventListener('click', (e) => {
            e.preventDefault();
            const target = tab.dataset.tab || 'overview';
            window.location.hash = target;
            switchTab(target);
          });
        });

        // Listen for hash change in URL
        window.addEventListener('hashchange', () => {
          const hash = window.location.hash.replace('#', '') || 'overview';
          if (tabTitles[hash]) {
            switchTab(hash);
          }
        });

        // Initialize on page load based on current hash
        const initialHash = window.location.hash.replace('#', '') || 'overview';
        if (tabTitles[initialHash]) {
          switchTab(initialHash);
        }
      }

      // ─────────────────────────────────────────
      // Bank Soal Filter & Table Management
      // ─────────────────────────────────────────
      function initBankSoalFilter() {
        const rows = document.querySelectorAll<HTMLElement>('.question-admin-row');
        const pillBtns = document.querySelectorAll<HTMLButtonElement>('.pool-pills .pill-btn');
        const searchInput = document.getElementById('input-search-soal') as HTMLInputElement | null;
        const categorySelect = document.getElementById('select-category-filter') as HTMLSelectElement | null;
        const diffSelect = document.getElementById('select-difficulty-filter') as HTMLSelectElement | null;
        const countText = document.getElementById('filtered-count-text');
        const emptyRow = document.getElementById('q-empty-row');

        let activePool = 'all';
        let searchQuery = '';
        let activeCategory = 'all';
        let activeDiff = 'all';

        function applyFilters() {
          let visibleCount = 0;

          rows.forEach((row) => {
            const cardPool = row.dataset.pool || '';
            const cardCat = row.dataset.category || '';
            const cardDiff = row.dataset.difficulty || '';
            const cardText = row.dataset.text || '';

            const matchPool = activePool === 'all' || cardPool === activePool;
            const matchCat = activeCategory === 'all' || cardCat === activeCategory;
            const matchDiff = activeDiff === 'all' || cardDiff === activeDiff;
            const matchSearch = !searchQuery || cardText.includes(searchQuery);

            if (matchPool && matchCat && matchDiff && matchSearch) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          if (emptyRow) {
            emptyRow.style.display = visibleCount === 0 ? '' : 'none';
          }

          if (countText) {
            countText.innerHTML = `Menampilkan <strong>${visibleCount}</strong> dari <strong>${rows.length}</strong> butir pertanyaan`;
          }
        }

        // Pill clicks
        pillBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            pillBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            activePool = btn.dataset.pool || 'all';
            applyFilters();
          });
        });

        // Search input with debounce
        searchInput?.addEventListener('input', (e) => {
          searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
          applyFilters();
        });

        // Category dropdown
        categorySelect?.addEventListener('change', (e) => {
