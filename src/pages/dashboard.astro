    height: 15px;
  }

  /* Timer & Scoring setup */
  .scoring-setup-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .timer-config-card, .scoring-matrix-card {
    background: #ffffff;
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-md);
    padding: 14px;
  }

  .score-points-list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--dash-text-body);
  }

  /* Step 8 Publish Grid */
  .publish-step-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .dist-summary-box {
    background: #f8fafc;
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-md);
    padding: 10px 12px;
  }

  .qr-preview-card {
    background: #ffffff;
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-md);
    padding: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .qr-preview-svg-box {
    background: #fffdf9;
    border: 1px solid var(--dash-gold-border);
    border-radius: var(--radius-md);
    padding: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* QR Modal Body */
  .qr-modal-body {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .qr-display-frame {
    background: #fffdf9;
    border: 1px solid var(--dash-gold-border);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
  }

  .qr-large-svg {
    display: block;
  }

  .qr-modal-info {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .qr-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--dash-border-subtle);
    padding-bottom: 4px;
  }

  .qr-url-copy-box {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Rules Grid */
  .rules-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .rule-card {
    background: var(--dash-bg-surface);
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rule-card-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border-bottom: 1px solid var(--dash-border-subtle);
    padding-bottom: 0.75rem;
  }

  .rule-icon-circle {
    width: 34px;
    height: 34px;
    background: var(--dash-gold-light);
    border: 1px solid var(--dash-gold-border);
    border-radius: var(--radius-md);
    color: var(--dash-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .rule-card-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--dash-text-main);
    margin: 0 0 2px 0;
  }

  .rule-card-desc {
    font-size: 0.75rem;
    color: var(--dash-text-muted);
    display: block;
  }

  .rule-summary-banner {
    background: var(--dash-gold-light);
    border: 1px solid var(--dash-gold-border);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    display: flex;
    justify-content: space-between;
    font-size: 0.76rem;
    color: var(--dash-gold);
    margin-bottom: 0.85rem;
  }

  .group-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--dash-text-main);
    margin: 0 0 0.5rem 0;
  }

  .quota-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--dash-border-subtle);
    gap: 0.75rem;
  }

  .quota-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quota-input-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .input-number-dash {
    width: 52px;
    padding: 5px 6px;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-weight: 700;
    text-align: center;
    font-size: 0.85rem;
    background: #ffffff;
    color: var(--dash-text-main);
    outline: none;
    transition: border-color 0.15s ease;
  }

  .input-number-dash:focus {
    border-color: var(--dash-gold);
    box-shadow: 0 0 0 3px rgba(150, 113, 38, 0.12);
  }

  .label-with-val {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .dash-field-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--dash-text-main);
  }

  .dash-range-slider {
    width: 100%;
    accent-color: var(--dash-gold);
    cursor: pointer;
  }

  .field-hint {
    font-size: 0.72rem;
    color: var(--dash-text-muted);
    line-height: 1.35;
    display: block;
    margin-top: 3px;
  }

  .radio-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .radio-option {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-md);
    background: #ffffff;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .radio-option:hover {
    background: #f8fafc;
    border-color: var(--dash-border-hover);
  }

  .radio-option input {
    margin-top: 3px;
    accent-color: var(--dash-gold);
  }

  .scoring-explanation-box {
    background: var(--dash-gold-light);
    border: 1px solid var(--dash-gold-border);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    margin-bottom: 0.85rem;
  }

  .scoring-table-preview {
    border: 1px solid var(--dash-border);
    border-radius: var(--radius-md);
    background: #ffffff;
    overflow: hidden;
  }

  .sc-row {
    display: grid;
    grid-template-columns: 1.5fr 1.5fr 1fr;
    padding: 7px 10px;
    border-bottom: 1px solid var(--dash-border-subtle);
  }

  .sc-head {
    background: #f8fafc;
    font-weight: 600;
    border-bottom: 1px solid var(--dash-border);
    color: var(--dash-text-muted);
  }

  .sc-foot {
    background: var(--dash-gold-light);
    border-top: 1px solid var(--dash-gold-border);
    border-bottom: none;
  }

  .switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--dash-border-subtle);
    gap: 0.75rem;
  }

  .dash-switch {
    position: relative;
    display: inline-block;
    width: 38px;
    height: 22px;
    flex-shrink: 0;
  }

  .dash-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #cbd5e1;
    border-radius: 22px;
    transition: .15s ease;
  }

  .switch-slider:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 3px;
    background-color: #ffffff;
    border-radius: 50%;
    transition: .15s ease;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }

  .dash-switch input:checked + .switch-slider {
    background-color: var(--dash-gold);
  }

  .dash-switch input:checked + .switch-slider:before {
    transform: translateX(16px);
  }

  /* =========================================================
     TAB 4: ANALITIK PERFORMA SOAL STYLING
     ========================================================= */
  .question-stat-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .q-stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--dash-border-subtle);
  }

  .q-stat-top {
    display: flex;
    justify-content: space-between;
  }

  .q-stat-bar-track {
    height: 6px;
    background: #f1f5f9;
    border-radius: 3px;
    overflow: hidden;
  }

  .q-stat-bar-fill {
    height: 100%;
    border-radius: 3px;
  }

  .fill-danger { background: #ef4444; }
  .fill-warning { background: #f59e0b; }
  .fill-success { background: #10b981; }

  .status-chip {
    display: inline-block;
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
