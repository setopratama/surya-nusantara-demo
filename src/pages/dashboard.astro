  .textarea-dash:focus,
  .input-textarea-dash:focus {
    border-color: var(--dash-gold);
    box-shadow: 0 0 0 3px rgba(150, 113, 38, 0.12);
  }

  .options-input-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .option-input-row {
    display: flex;
    align-items: center;
