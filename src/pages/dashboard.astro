                  </div>
                </div>

                <div class="table-responsive">
                  <table class="dash-table">
                    <thead>
                      <tr>
                        <th>ID Soal</th>
                        <th>Pertanyaan Ringkas</th>
                        <th>Pilar</th>
                        <th>Pool</th>
                        <th>Total Tayang</th>
                        <th>Tingkat Akurasi</th>
                        <th>Rata-rata Waktu</th>
                        <th>Status Indeks</th>
                      </tr>
                    </thead>
                    <tbody>
                      {QUESTIONS_BANK.slice(0, 15).map((q, idx) => {
                        const acc = idx === 0 ? 94 : idx === 1 ? 82 : idx === 2 ? 65 : idx === 3 ? 93 : idx === 4 ? 53 : 75 + (idx % 15);
                        const avgSec = (3.2 + (idx * 0.4) % 4).toFixed(1);
                        const accClass = acc >= 80 ? 'text-success' : acc >= 60 ? 'text-warning' : 'text-danger';
                        const statusBadge = acc < 60 ? 'status-review' : 'status-optimal';
                        const statusLabel = acc < 60 ? 'Perlu Review' : 'Optimal';

                        return (
                          <tr>
                            <td class="font-mono font-bold text-muted">{q.id.toUpperCase()}</td>
                            <td class="max-w-xs truncate" title={q.text}>{q.text}</td>
                            <td><span class={`q-badge ${pillarBadges[q.category] || 'badge-pillar-craft'}`}>{pillarLabels[q.category] || q.category}</span></td>
                            <td class="font-mono text-xs">{q.isBrandPool ? 'Brand Recall' : 'Umum'}</td>
                            <td class="font-mono tabular-nums">{120 + idx * 8} kali</td>
                            <td class={`font-mono font-bold tabular-nums ${accClass}`}>{acc}%</td>
                            <td class="font-mono tabular-nums">{avgSec}s</td>
                            <td><span class={`status-chip ${statusBadge}`}>{statusLabel}</span></td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
