        document.getElementById('btn-save-draft')?.addEventListener('click', () => {
          closeModal();
          showToast('Draft soal & konfigurasi pesan brand berhasil disimpan dalam antrean kurasi.');
        });

        // Open modal for EDIT / DETAIL from table
        function openEditModal(id: string) {
          const cleanId = id.toLowerCase();
          const q = questionMap.get(cleanId);
          const modalTitle = document.getElementById('modal-title');
          const modalBadge = document.getElementById('modal-id-badge');
          const modalSubtitle = document.getElementById('modal-subtitle-text');

          if (q) {
            const qNum = questionsList.findIndex((item: any) => item.id.toLowerCase() === cleanId) + 1;
            if (modalTitle) modalTitle.textContent = `Detail & Sunting Soal #${qNum}`;
            if (modalBadge) modalBadge.textContent = `ID: ${q.id.toUpperCase()}`;
            if (modalSubtitle) modalSubtitle.textContent = 'Perbarui materi pertanyaan, opsi pilihan ganda, pembahasan edukatif, serta pesan brand slide transisi.';
            if (inputId) inputId.value = q.id;
            if (selectPool) selectPool.value = q.isBrandPool ? 'brand' : 'general';
            if (selectCategory) selectCategory.value = q.category;
            if (selectDiff) selectDiff.value = q.difficulty || 'sedang';
            if (inputQuestion) inputQuestion.value = q.text;

            const optA = q.options?.find((o: any) => o.id === 'A') || q.options?.[0];
            const optB = q.options?.find((o: any) => o.id === 'B') || q.options?.[1];
            const optC = q.options?.find((o: any) => o.id === 'C') || q.options?.[2];
            const optD = q.options?.find((o: any) => o.id === 'D') || q.options?.[3];

            if (inputOptA && optA) inputOptA.value = optA.text;
            if (inputOptB && optB) inputOptB.value = optB.text;
            if (inputOptC && optC) inputOptC.value = optC.text;
            if (inputOptD && optD) inputOptD.value = optD.text;

            const targetRadio = document.querySelector<HTMLInputElement>(`input[name="correct-opt-key"][value="${q.correctOptionId}"]`);
            if (targetRadio) targetRadio.checked = true;

            if (inputExplanation) inputExplanation.value = q.explanation || '';

            // Populate brand message if exists or use default
            if (q.brandMessage) {
              if (selectBrandPillar) selectBrandPillar.value = q.brandMessage.pillar || 'Dedikasi Di Balik Rasa';
              if (inputBrandTitle) inputBrandTitle.value = q.brandMessage.title || '';
              if (inputBrandMessage) inputBrandMessage.value = q.brandMessage.message || '';
            } else {
              if (selectBrandPillar) selectBrandPillar.value = 'Dedikasi Di Balik Rasa';
              if (inputBrandTitle) inputBrandTitle.value = '';
              if (inputBrandMessage) inputBrandMessage.value = '';
            }

            // Reset tab to quiz view
            tabPrevQuiz?.click();

            updatePreview();
            if (modal) modal.style.display = 'flex';
          } else {
            if (modalTitle) modalTitle.textContent = `Sunting Soal ${id.toUpperCase()}`;
            if (inputId) inputId.value = id.toUpperCase();
            if (modal) modal.style.display = 'flex';
          }
