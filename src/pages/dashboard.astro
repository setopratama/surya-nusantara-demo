        // Preview elements (Quiz Question Screen)
        const prevCatBadge = document.getElementById('prev-category-badge');
        const prevQuestion = document.getElementById('prev-question-text');
        const prevTextA = document.getElementById('prev-opt-text-a');
        const prevTextB = document.getElementById('prev-opt-text-b');
        const prevTextC = document.getElementById('prev-opt-text-c');
        const prevTextD = document.getElementById('prev-opt-text-d');
        const prevExplanation = document.getElementById('prev-explanation-text');
        const charCount = document.getElementById('char-count-q');

        // Preview elements (Transition Slide Screen)
        const prevBmPillar = document.getElementById('prev-bm-pillar');
        const prevBmTitle = document.getElementById('prev-bm-title');
        const prevBmMessage = document.getElementById('prev-bm-message');

        // Preview Tab Switcher
        const tabPrevQuiz = document.getElementById('tab-prev-quiz');
        const tabPrevTrans = document.getElementById('tab-prev-transition');
        const screenPrevQuiz = document.getElementById('preview-screen-quiz');
        const screenPrevTrans = document.getElementById('preview-screen-transition');

        tabPrevQuiz?.addEventListener('click', () => {
          tabPrevQuiz.classList.add('active');
          tabPrevTrans?.classList.remove('active');
          if (screenPrevQuiz) screenPrevQuiz.style.display = '';
          if (screenPrevTrans) screenPrevTrans.style.display = 'none';
        });

        tabPrevTrans?.addEventListener('click', () => {
          tabPrevTrans.classList.add('active');
          tabPrevQuiz?.classList.remove('active');
          if (screenPrevTrans) screenPrevTrans.style.display = '';
          if (screenPrevQuiz) screenPrevQuiz.style.display = 'none';
        });

        // Parse questions data for editing
        const rawEl = document.getElementById('questions-bank-raw');
        const questionsList: any[] = rawEl ? JSON.parse(rawEl.textContent || '[]') : [];
        const questionMap = new Map(questionsList.map((q: any) => [q.id.toLowerCase(), q]));

        function updatePreview() {
          if (prevQuestion && inputQuestion) {
            prevQuestion.textContent = inputQuestion.value || 'Teks pertanyaan akan tampil di sini...';
            if (charCount) charCount.textContent = `${inputQuestion.value.length} / 200 karakter`;
          }

          if (prevCatBadge && selectCategory) {
            const catText = selectCategory.options[selectCategory.selectedIndex]?.text || '';
            prevCatBadge.textContent = catText.toUpperCase();
          }

          if (prevTextA && inputOptA) prevTextA.textContent = inputOptA.value || 'Opsi A...';
          if (prevTextB && inputOptB) prevTextB.textContent = inputOptB.value || 'Opsi B...';
          if (prevTextC && inputOptC) prevTextC.textContent = inputOptC.value || 'Opsi C...';
          if (prevTextD && inputOptD) prevTextD.textContent = inputOptD.value || 'Opsi D...';

          if (prevExplanation && inputExplanation) {
            prevExplanation.textContent = inputExplanation.value || 'Penjelasan edukatif akan tampil di sini saat peserta salah menjawab.';
          }

          // Update active correct highlight in preview
          const checkedRadio = document.querySelector<HTMLInputElement>('input[name="correct-opt-key"]:checked');
          const correctKey = checkedRadio ? checkedRadio.value : 'A';

          ['a', 'b', 'c', 'd'].forEach((key) => {
            const row = document.getElementById(`prev-opt-row-${key}`);
            if (row) {
              if (key.toUpperCase() === correctKey) {
                row.classList.add('is-correct');
              } else {
                row.classList.remove('is-correct');
              }
            }
          });

          // Update Brand Message Preview on Transition Slide
          if (prevBmPillar && selectBrandPillar) {
            prevBmPillar.textContent = (selectBrandPillar.value || 'DEDIKASI DI BALIK RASA').toUpperCase();
          }
          if (prevBmTitle && inputBrandTitle) {
            prevBmTitle.textContent = inputBrandTitle.value || 'Judul Pesan Brand';
          }
          if (prevBmMessage && inputBrandMessage) {
            prevBmMessage.textContent = inputBrandMessage.value || 'Narasi pesan brand akan tampil di slide transisi saat peserta beralih dari soal ini.';
            if (charCountBm) charCountBm.textContent = `${inputBrandMessage.value.length} / 180 karakter`;
          }
        }

        // Attach input listeners for live updates
        inputQuestion?.addEventListener('input', updatePreview);
        selectCategory?.addEventListener('change', updatePreview);
        inputExplanation?.addEventListener('input', updatePreview);
        inputOptA?.addEventListener('input', updatePreview);
        inputOptB?.addEventListener('input', updatePreview);
        inputOptC?.addEventListener('input', updatePreview);
        inputOptD?.addEventListener('input', updatePreview);

        // Brand message listeners
        selectBrandPillar?.addEventListener('change', updatePreview);
        inputBrandTitle?.addEventListener('input', updatePreview);
        inputBrandMessage?.addEventListener('input', updatePreview);

        document.querySelectorAll('input[name="correct-opt-key"]').forEach((r) => {
          r.addEventListener('change', updatePreview);
        });

        // Open modal for NEW question
