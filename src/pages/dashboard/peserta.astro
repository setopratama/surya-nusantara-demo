      .kpi-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .kpi-card-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--dash-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .kpi-icon-wrap {
        color: var(--dash-gold);
      }

      .kpi-value-row {
        display: flex;
        align-items: baseline;
        gap: 0.45rem;
      }

      .kpi-value {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--dash-text-main);
        line-height: 1.1;
      }

      .kpi-sub-unit {
        font-size: 0.78rem;
        color: var(--dash-text-muted);
      }

      .kpi-badge {
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.1rem 0.35rem;
        border-radius: var(--radius-sm);
      }

      .kpi-badge-positive {
        background: #ecfdf5;
        color: #047857;
      }

      .kpi-desc {
        font-size: 0.7rem;
        color: var(--dash-text-muted);
        line-height: 1.35;
      }

      /* Main Card & Toolbar */
      .dash-card {
        background: #ffffff;
        border: 1px solid var(--dash-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
      }

      .table-toolbar {
        padding: 0.85rem 1.25rem;
        background: #ffffff;
        border-bottom: 1px solid var(--dash-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .toolbar-left {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
        flex: 1;
      }

      .search-input-wrap {
        position: relative;
        min-width: 280px;
        flex: 1;
        max-width: 380px;
      }

      .search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--dash-text-muted);
      }

      .input-search-dash {
        width: 100%;
        padding: 0.42rem 0.75rem 0.42rem 2.1rem;
        border: 1px solid var(--dash-border);
        border-radius: var(--radius-md);
        font-size: 0.8rem;
        background: #ffffff;
        color: var(--dash-text-main);
        outline: none;
      }

      .input-search-dash:focus {
        border-color: var(--dash-gold);
        box-shadow: 0 0 0 2px var(--dash-gold-light);
      }

      .filter-select-input {
        padding: 0.42rem 0.65rem;
        border: 1px solid var(--dash-border);
        border-radius: var(--radius-md);
        font-size: 0.78rem;
        background: #ffffff;
        color: var(--dash-text-body);
        outline: none;
        cursor: pointer;
      }

      .toolbar-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .table-count-label {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--dash-text-muted);
      }

      /* Table Styles */
      .table-responsive {
        width: 100%;
        overflow-x: auto;
      }

      .dash-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.78rem;
      }

      .dash-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.65rem 0.85rem;
        border-bottom: 1px solid var(--dash-border);
        white-space: nowrap;
      }

      :global(.dash-table thead th.th-no),
      :global(.dash-table tbody td.td-no),
      :global(.th-no),
      :global(.td-no) {
        width: 60px !important;
        min-width: 60px !important;
        max-width: 60px !important;
        text-align: center !important;
        vertical-align: middle !important;
        padding-left: 0.25rem !important;
        padding-right: 0.25rem !important;
      }

      :global(.col-num-badge) {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        min-width: 28px !important;
        width: 28px !important;
        height: 24px !important;
        padding: 0 4px !important;
        font-family: var(--font-mono) !important;
        font-size: 0.75rem !important;
        font-weight: 700 !important;
        color: #334155 !important;
        background: #f1f5f9 !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: var(--radius-sm) !important;
        margin: 0 auto !important;
        text-align: center !important;
        box-shadow: 0 1px 1px rgba(0, 0, 0, 0.03) !important;
      }

      :global(.dash-table tbody td) {
        padding: 0.7rem 0.85rem;
        border-bottom: 1px solid var(--dash-border-subtle);
        color: var(--dash-text-body);
        vertical-align: middle;
      }

      :global(.dash-table tbody tr:hover) {
        background-color: #fafbfc;
      }

      :global(.id-mono-chip) {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        padding: 0.15rem 0.4rem;
        background: #f1f5f9;
        color: #334155;
        border-radius: var(--radius-sm);
      }

      :global(.dist-cell-wrap) {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      :global(.dist-mini-badge) {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--dash-gold);
      }

      :global(.dist-mini-name) {
        font-size: 0.72rem;
        color: var(--dash-text-muted);
        white-space: nowrap;
      }

      :global(.age-chip) {
        display: inline-block;
        padding: 0.15rem 0.45rem;
        font-size: 0.7rem;
        font-weight: 600;
        color: #334155;
        background: #f1f5f9;
        border-radius: var(--radius-sm);
        white-space: nowrap;
      }

      :global(.brand-chip) {
        display: inline-block;
        padding: 0.15rem 0.45rem;
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--dash-gold);
        background: var(--dash-gold-light);
        border: 1px solid var(--dash-gold-border);
        border-radius: var(--radius-sm);
        white-space: nowrap;
      }

      :global(.score-pill) {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        border-radius: 999px;
      }

      :global(.score-high) {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
      }

      :global(.score-mid) {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #a7f3d0;
      }

      :global(.score-fair) {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
      }

      :global(.score-low) {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }

      :global(.badge-status-done) {
        display: inline-block;
        padding: 0.15rem 0.45rem;
        font-size: 0.68rem;
        font-weight: 600;
        background: #ecfdf5;
        color: #047857;
        border-radius: var(--radius-sm);
      }

      :global(.badge-status-dropout) {
        display: inline-block;
        padding: 0.15rem 0.45rem;
        font-size: 0.68rem;
        font-weight: 600;
        background: #fef2f2;
        color: #b91c1c;
        border-radius: var(--radius-sm);
      }

      :global(.empty-state-cell) {
        padding: 3rem 1.5rem;
        text-align: center;
      }

      :global(.empty-state-wrap) {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: var(--dash-text-muted);
      }

      .empty-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--dash-text-main);
      }

      .empty-desc {
        font-size: 0.78rem;
        color: var(--dash-text-muted);
      }

      /* Table Footer */
      .table-footer-bar {
        padding: 0.75rem 1.25rem;
        background: #f8fafc;
        border-top: 1px solid var(--dash-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      /* Toast */
      .toast-notify {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        background: #0f172a;
        color: #ffffff;
        padding: 0.75rem 1.15rem;
        font-size: 0.8rem;
        font-weight: 500;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-md);
        z-index: 100;
      }

      /* Responsive */
      @media (max-width: 1024px) {
        .kpi-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .dash-view-header {
          flex-direction: column;
          align-items: stretch;
        }
      }

      @media (max-width: 768px) {
        .kpi-grid {
          grid-template-columns: 1fr;
        }
        .dash-sidebar {
          position: fixed;
          top: 58px;
          bottom: 0;
          left: -240px;
          z-index: 50;
          transition: left 0.2s ease;
          box-shadow: 4px 0 12px rgba(0, 0, 0, 0.08);
        }
        .dash-sidebar.open {
          left: 0;
        }
        .btn-sidebar-toggle {
          display: flex;
        }
        .dash-main {
          padding: 1rem;
        }
        .dist-meta-banner {
          flex-direction: column;
          align-items: flex-start;
        }
        .table-toolbar {
          flex-direction: column;
          align-items: stretch;
        }
        .toolbar-left {
          flex-direction: column;
          width: 100%;
        }
        .search-input-wrap {
          min-width: unset;
          max-width: unset;
          width: 100%;
        }
      }
    </style>
  </body>
</html>
