---
---

<section id="stage-result" class="stage-card" style="display: none;" aria-labelledby="result-title">
  <div class="card-header">
    <h1 id="result-title" class="result-title">Kuis Selesai!</h1>
    <p class="result-sub">Terima kasih telah mengikuti Kuis Dedikasi Di Balik Rasa.</p>
  </div>

  <!-- Score Display -->
  <div class="score-box" aria-live="polite">
    <div class="score-label">Skor Akhir Kamu</div>
    <div class="score-value" id="final-score-value" aria-label="Skor akhir">
      <span id="score-number" class="tabular-nums">0</span>
      <span class="score-max">/ 100</span>
    </div>
    <div id="score-stars" class="score-stars" aria-label="Penilaian bintang"></div>
    <p id="score-message" class="score-message"></p>
  </div>

  <!-- Breakdown table -->
  <div class="breakdown-panel">
    <h2 class="breakdown-heading">Rincian Jawaban</h2>
    <div id="breakdown-list" class="breakdown-list" role="list" aria-label="Rincian skor per soal">
      <!-- Rendered dynamically -->
    </div>
  </div>

  <!-- CTA Buttons -->
  <div class="result-actions">
    <a
      id="btn-redirect"
      class="btn-primary"
      href="#demo-placeholder"
      role="button"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Kunjungi halaman Surya Nusantara"
    >
      <span>Kunjungi Surya Nusantara</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>

    <button id="btn-play-again" class="btn-secondary" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="1 4 1 10 7 10"></polyline>
        <path d="M3.51 15a9 9 0 1 0 .49-3.19"></path>
      </svg>
      <span>Main Lagi</span>
    </button>
  </div>

  <p class="redirect-note">
    ⚠️ <strong>Demo Only:</strong> Tombol "Kunjungi Surya Nusantara" mengarah ke URL placeholder. URL tujuan final perlu dikonfirmasi dan dikonfigurasi oleh klien sebelum peluncuran.
  </p>
</section>

<style>
  .stage-card {
    text-align: center;
  }

  .result-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text-display);
    line-height: 1.1;
    margin-bottom: var(--space-1);
    letter-spacing: -0.01em;
  }

  .result-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  /* ── Score Box ── */
  .score-box {
    background: var(--surface-subtle);
    border: 1.5px solid var(--border-card);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-5);
    box-shadow: 0 4px 15px rgba(196, 154, 69, 0.1);
  }

  .score-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-accent);
    margin-bottom: var(--space-2);
  }

  .score-value {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    margin-bottom: var(--space-2);
  }

  #score-number {
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-gold-300);
    line-height: 1;
    transition: color 0.3s;
  }

  .score-max {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .score-stars {
    font-size: 1.6rem;
    margin-bottom: var(--space-2);
    min-height: 1.6rem;
    letter-spacing: 2px;
  }

  .score-message {
    font-size: 0.95rem;
    color: var(--text-main);
    line-height: 1.45;
    font-weight: 500;
  }

  /* ── Breakdown ── */
  .breakdown-panel {
    text-align: left;
    margin-bottom: var(--space-5);
  }

  .breakdown-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--text-display);
    margin-bottom: var(--space-3);
    text-align: center;
    font-weight: 700;
  }

  .breakdown-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :global(.breakdown-row) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--surface-subtle);
    border: 1.5px solid var(--border-subtle);
    border-radius: 0px;
    padding: var(--space-2) var(--space-3);
    font-size: 0.85rem;
    color: var(--text-main);
  }

  :global(.breakdown-row.correct) {
    border-left: 4px solid var(--color-success);
    background: var(--color-success-bg);
  }

  :global(.breakdown-row.incorrect) {
    border-left: 4px solid var(--color-error);
    background: var(--color-error-bg);
  }

  :global(.breakdown-row.timeout) {
    border-left: 4px solid var(--border-subtle);
    opacity: 0.85;
  }

  :global(.breakdown-qnum) {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--text-accent);
    min-width: 28px;
  }

  :global(.breakdown-status) {
    font-size: 0.85rem;
    font-weight: 600;
    min-width: 70px;
  }

  :global(.breakdown-score) {
    font-family: var(--font-mono);
    font-weight: 700;
    margin-left: auto;
  }

  /* ── Actions ── */
  .result-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    background: linear-gradient(135deg, var(--color-gold-500) 0%, #a87e2b 100%);
    color: var(--color-brown-950);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: var(--radius-button);
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(196, 154, 69, 0.35);
    transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    box-shadow: 0 6px 16px rgba(196, 154, 69, 0.4);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    background: var(--surface-subtle);
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    border: 1.5px solid var(--border-card);
    border-radius: var(--radius-button);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .btn-secondary:hover {
    background: var(--surface-option-hover);
    transform: translateY(-1px);
  }

  .redirect-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.45;
    border: 1px dashed var(--border-card);
    padding: var(--space-3);
    border-radius: var(--radius-input);
    text-align: left;
    background: var(--surface-subtle);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
