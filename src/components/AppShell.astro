---
interface Props {
  title?: string;
}

const { title = 'Kuis Dedikasi Di Balik Rasa — Surya Nusantara' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Kuis Dedikasi Di Balik Rasa - Pengalaman interaktif Surya Nusantara" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="app-wrapper">
      <header class="app-header" role="banner">
        <div class="brand-badge">
          <div class="brand-crest">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-name">SURYA NUSANTARA</span>
            <span class="brand-tagline">DEDIKASI DI BALIK RASA</span>
          </div>
        </div>
      </header>

      <main class="app-main" id="main-content" role="main">
        <slot />
      </main>

      <footer class="app-footer" role="contentinfo">
        <div class="age-warning-pill">
          <span class="warning-badge" aria-label="Khusus 21 tahun ke atas">21+</span>
          <span class="warning-text">KHUSUS PEROKOK DEWASA USIA 21 TAHUN ATAU LEBIH. TIDAK UNTUK DIJUAL KEPADA ANAK-ANAK &amp; WANITA HAMIL.</span>
        </div>
        <p class="demo-disclaimer">
          Demo Interaktif — Konsep Consumer Engagement Kuis Dedikasi Di Balik Rasa
        </p>
      </footer>
    </div>
  </body>
</html>

<style>
  .app-wrapper {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: radial-gradient(circle at 50% 20%, #3d2315 0%, #28170f 75%);
    position: relative;
    overflow-x: hidden;
  }

  .app-header {
    padding: var(--space-4) var(--space-5);
    display: flex;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid rgba(196, 154, 69, 0.25);
    background: rgba(40, 23, 15, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .brand-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .brand-crest {
    color: var(--color-gold-500);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-gold-300);
    line-height: 1.2;
  }

  .brand-tagline {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--color-cream-100);
    opacity: 0.8;
  }

  .app-main {
    flex: 1;
    width: 100%;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .app-footer {
    padding: var(--space-4) var(--space-4);
    padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    text-align: center;
    border-top: 1px solid rgba(196, 154, 69, 0.15);
    background: rgba(28, 15, 9, 0.9);
  }

  .age-warning-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(196, 154, 69, 0.35);
    border-radius: 9999px;
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-2);
    max-width: 100%;
  }

  .warning-badge {
    background: var(--color-accent-terracotta);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .warning-text {
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-cream-100);
    letter-spacing: 0.04em;
    text-align: left;
    line-height: 1.2;
  }

  .demo-disclaimer {
    font-size: 0.7rem;
    color: var(--color-gold-500);
    opacity: 0.75;
    margin-top: 2px;
  }

  @media (min-width: 768px) {
    .app-main {
      padding: var(--space-8) var(--space-5);
    }
  }
</style>
