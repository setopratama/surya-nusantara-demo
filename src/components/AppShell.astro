---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Kuis Dedikasi Di Balik Rasa — Surya Nusantara' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Kuis Dedikasi Di Balik Rasa - Pengalaman interaktif Surya Nusantara" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@600;700&family=Roboto+Condensed:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <div class="app-wrapper">
      <header class="app-header" role="banner">
        <div class="brand-masthead">
          <img
            src="/assets/logo_gold.png"
            alt="Surya Nusantara — Dedikasi Di Balik Rasa"
            class="brand-hero-logo"
            width="1536"
            height="1024"
            loading="eager"
          />
        </div>
        <div class="brand-divider" aria-hidden="true"></div>
      </header>

      <main class="app-main" id="main-content" role="main">
        <slot />
      </main>

      <footer class="app-footer" role="contentinfo">
        <div class="age-warning-pill">
          <span class="warning-badge" aria-label="Khusus 21 tahun ke atas">21+</span>
          <span class="warning-text">KHUSUS PEROKOK DEWASA USIA 21 TAHUN ATAU LEBIH. TIDAK UNTUK DIJUAL KEPADA ANAK-ANAK &amp; WANITA HAMIL.</span>
        </div>
        <p class="demo-disclaimer">
          Demo Interaktif — Konsep Consumer Engagement Kuis Dedikasi Di Balik Rasa &bull;
          <a href="/dashboard" class="footer-dash-link">Dashboard Analitik</a>
        </p>
      </footer>
    </div>
  </body>
</html>

<style>
  .app-wrapper {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-app);
    background-image: var(--bg-gradient);
    background-position: center top;
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    position: relative;
    overflow-x: hidden;
  }

  .app-header {
    width: 100%;
    background: transparent;
    position: relative;
    z-index: 40;
  }

  .brand-masthead {
    width: 100%;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-3);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .brand-hero-logo {
    height: 96px;
    width: auto;
    max-width: 250px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 6px 20px rgba(196, 154, 69, 0.45)) drop-shadow(0 2px 6px rgba(0, 0, 0, 0.9));
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .brand-hero-logo:hover {
    transform: translateY(-2px) scale(1.02);
    filter: drop-shadow(0 8px 26px rgba(196, 154, 69, 0.6)) drop-shadow(0 3px 8px rgba(0, 0, 0, 0.95));
  }

  .brand-divider {
    width: 100%;
    max-width: var(--content-max-width);
    margin: 0 auto;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      rgba(196, 154, 69, 0) 0%,
      rgba(196, 154, 69, 0.5) 20%,
      rgba(226, 196, 123, 0.95) 50%,
      rgba(196, 154, 69, 0.5) 80%,
      rgba(196, 154, 69, 0) 100%
    );
    box-shadow: 0 1px 8px rgba(196, 154, 69, 0.35);
  }

  @media (min-width: 768px) {
    .brand-masthead {
      padding: var(--space-6) var(--space-4) var(--space-4);
    }

    .brand-hero-logo {
      height: 125px;
      max-width: 300px;
    }
  }

  .app-main {
    flex: 1;
    width: 100%;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .app-footer {
    padding: var(--space-4) var(--space-4);
    padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    text-align: center;
    border-top: 1px solid var(--footer-border);
    background: var(--footer-bg);
  }

  .age-warning-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border-subtle);
    border-radius: 0px;
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-2);
    max-width: 100%;
  }

  .warning-badge {
    background: var(--color-accent-terracotta);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 0px;
    letter-spacing: 0.05em;
  }

  .warning-text {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-align: left;
    line-height: 1.2;
  }

  .demo-disclaimer {
    font-size: 0.7rem;
    color: var(--color-gold-500);
    font-weight: 500;
    margin-top: 2px;
    opacity: 0.85;
  }

  .footer-dash-link {
    color: var(--color-gold-300);
    text-decoration: underline;
    font-weight: 600;
    margin-left: 4px;
    transition: color 0.15s ease;
  }

  .footer-dash-link:hover {
    color: #ffffff;
  }

  @media (min-width: 768px) {
    .app-main {
      padding: var(--space-8) var(--space-5);
    }
  }
</style>
