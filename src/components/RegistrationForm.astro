---
import { AGE_BANDS, DOMICILES, OCCUPATIONS, CURRENT_BRANDS } from '../data/registration-options';
---

<section id="stage-registration" class="stage-card" style="display: none;" aria-labelledby="reg-title">
  <div class="card-header">
    <div class="step-badge">Langkah 1 dari 4: Pendaftaran Peserta</div>
    <h1 id="reg-title" class="title-display">Data Diri Peserta</h1>
    <p class="subtitle-text">
      Lengkapi data singkat berikut untuk memulai sesi kuis dan pencatatan skor Anda.
    </p>
  </div>

  <form id="form-registration" class="form-container" novalidate>
    <!-- Field 1: Nama / Username -->
    <div class="form-group">
      <label for="reg-name" class="form-label">
        Nama Lengkap / Username <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="reg-name"
        name="name"
        class="form-input"
        placeholder="Contoh: Budi Santoso"
        autocomplete="name"
        required
      />
      <div id="err-name" class="field-error" style="display: none;" role="alert"></div>
    </div>

    <!-- Field 2: Rentang Usia -->
    <div class="form-group">
      <label for="reg-age" class="form-label">
        Rentang Usia <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <select id="reg-age" name="ageBand" class="form-select" required>
        <option value="" disabled selected>Pilih rentang usia...</option>
        {AGE_BANDS.map((band) => (
          <option value={band.value}>{band.label}</option>
        ))}
      </select>
      <div id="err-age" class="field-error" style="display: none;" role="alert"></div>
    </div>

    <!-- Field 3: Konfirmasi 21+ Checkbox -->
    <div class="form-group checkbox-group">
      <label class="checkbox-label" for="reg-confirm-21">
        <input type="checkbox" id="reg-confirm-21" name="isConfirmed21Plus" required />
        <span class="custom-checkbox"></span>
        <span class="checkbox-text">
          Saya menyatakan secara sadar bahwa saya adalah perokok dewasa yang berusia <strong>21 tahun atau lebih</strong>.
        </span>
      </label>
      <div id="err-confirm-21" class="field-error" style="display: none;" role="alert"></div>
    </div>

    <!-- Field 4: Domisili / Kota -->
    <div class="form-group">
      <label for="reg-domicile" class="form-label">
        Kota / Domisili <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <select id="reg-domicile" name="domicile" class="form-select" required>
        <option value="" disabled selected>Pilih kota domisili...</option>
        {DOMICILES.map((city) => (
          <option value={city}>{city}</option>
        ))}
      </select>
      <div id="err-domicile" class="field-error" style="display: none;" role="alert"></div>
    </div>

    <!-- Field 5: Pekerjaan -->
    <div class="form-group">
      <label for="reg-occupation" class="form-label">
        Bidang Pekerjaan <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <select id="reg-occupation" name="occupation" class="form-select" required>
        <option value="" disabled selected>Pilih bidang pekerjaan...</option>
        {OCCUPATIONS.map((occ) => (
          <option value={occ}>{occ}</option>
        ))}
      </select>
      <div id="err-occupation" class="field-error" style="display: none;" role="alert"></div>
    </div>

    <!-- Field 6: Merek Rokok Saat Ini -->
    <div class="form-group">
      <label for="reg-brand" class="form-label">
        Merek yang Biasa Dikonsumsi Saat Ini <span class="required-mark" aria-hidden="true">*</span>
      </label>
      <select id="reg-brand" name="currentBrand" class="form-select" required>
        <option value="" disabled selected>Pilih preferensi merek...</option>
        {CURRENT_BRANDS.map((brand) => (
          <option value={brand}>{brand}</option>
        ))}
      </select>
      <div id="err-brand" class="field-error" style="display: none;" role="alert"></div>
    </div>

    <div class="privacy-note">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>
        Data di atas hanya digunakan untuk keperluan simulasi kuis interaktif demo ini dan tidak disimpan secara permanen di server luar.
      </span>
    </div>

    <button type="submit" id="btn-submit-registration" class="btn-primary">
      <span>Lanjutkan ke Pengenalan Kampanye</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>
  </form>
</section>

<style>
  .stage-card {
    background: rgba(40, 23, 15, 0.95);
    border: 1px solid rgba(196, 154, 69, 0.3);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.3s ease;
  }

  .step-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-gold-300);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .title-display {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--color-gold-300);
    margin-bottom: var(--space-2);
    line-height: 1.2;
  }

  .subtitle-text {
    font-size: 0.9rem;
    color: var(--color-cream-100);
    line-height: 1.5;
    margin-bottom: var(--space-5);
  }

  .form-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-align: left;
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-cream-50);
  }

  .required-mark {
    color: #ff8a80;
  }

  .form-input, .form-select {
    width: 100%;
    min-height: 48px;
    background: rgba(56, 32, 20, 0.8);
    border: 1px solid rgba(196, 154, 69, 0.35);
    border-radius: var(--radius-input);
    padding: 0 var(--space-4);
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-cream-50);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--color-gold-500);
    box-shadow: 0 0 0 2px rgba(196, 154, 69, 0.25);
    outline: none;
  }

  .form-select option {
    background: var(--color-brown-900);
    color: var(--color-cream-50);
  }

  .checkbox-group {
    margin-top: var(--space-1);
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    cursor: pointer;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(196, 154, 69, 0.2);
    border-radius: var(--radius-input);
    padding: var(--space-3);
  }

  .checkbox-label input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .custom-checkbox {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid var(--color-gold-500);
    margin-top: 2px;
    flex-shrink: 0;
    display: inline-block;
    position: relative;
  }

  .checkbox-label input[type="checkbox"]:checked + .custom-checkbox {
    background: var(--color-gold-500);
  }

  .checkbox-label input[type="checkbox"]:checked + .custom-checkbox::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 6px;
    width: 4px;
    height: 9px;
    border: solid var(--color-brown-950);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-text {
    font-size: 0.85rem;
    color: var(--color-cream-100);
    line-height: 1.4;
  }

  .field-error {
    color: #ff8a80;
    font-size: 0.8rem;
    margin-top: 2px;
  }

  .privacy-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-cream-100);
    opacity: 0.8;
    background: rgba(0, 0, 0, 0.2);
    padding: var(--space-3);
    border-radius: var(--radius-input);
    line-height: 1.35;
  }

  .privacy-note svg {
    color: var(--color-gold-500);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .btn-primary {
    width: 100%;
    min-height: 48px;
    background: linear-gradient(135deg, var(--color-gold-500) 0%, #a87e2b 100%);
    color: var(--color-brown-950);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: var(--radius-button);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    cursor: pointer;
    margin-top: var(--space-2);
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
