---
---

<section id="stage-transition" class="stage-card" style="display: none;" aria-labelledby="transition-title">
  <div class="card-body">
    <div class="loader-ring" aria-hidden="true">
      <div class="ring-track"></div>
      <div class="ring-fill"></div>
    </div>

    <h2 id="transition-title" class="transition-heading">Menghitung Hasil Anda...</h2>
    <p class="transition-sub">Sementara itu, tahukah kamu tentang kekayaan Nusantara?</p>

    <div id="fun-fact-box" class="fun-fact-card" aria-live="polite">
      <div class="fact-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 16v-4M12 8h.01"></path>
        </svg>
      </div>
      <div>
        <p id="fact-origin" class="fact-origin"></p>
        <h3 id="fact-title" class="fact-title"></h3>
        <p id="fact-text" class="fact-text"></p>
      </div>
    </div>
  </div>
</section>

<style>
  .stage-card {
    background: rgba(40, 23, 15, 0.95);
    border: 1px solid rgba(196, 154, 69, 0.3);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.3s ease;
    text-align: center;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  /* ── Spinner ── */
  .loader-ring {
    position: relative;
    width: 72px;
    height: 72px;
  }

  .ring-track,
  .ring-fill {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 5px solid transparent;
  }

  .ring-track {
    border-color: rgba(196, 154, 69, 0.2);
  }

  .ring-fill {
    border-top-color: var(--color-gold-500);
    animation: spin 1.1s linear infinite;
  }

  .transition-heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-gold-300);
    line-height: 1.2;
  }

  .transition-sub {
    font-size: 0.85rem;
    color: var(--color-cream-100);
    opacity: 0.8;
    margin-top: -var(--space-2);
  }

  /* ── Fun Fact Card ── */
  .fun-fact-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    text-align: left;
    background: rgba(56, 32, 20, 0.6);
    border: 1px solid rgba(196, 154, 69, 0.3);
    border-radius: var(--radius-input);
    padding: var(--space-4);
    max-width: 100%;
    animation: fadeIn 0.4s ease;
  }

  .fact-icon {
    color: var(--color-gold-500);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .fact-origin {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold-500);
    margin-bottom: 2px;
  }

  .fact-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-cream-50);
    margin-bottom: var(--space-2);
  }

  .fact-text {
    font-size: 0.85rem;
    color: var(--color-cream-100);
    line-height: 1.5;
  }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
</style>
