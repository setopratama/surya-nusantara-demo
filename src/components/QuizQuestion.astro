---
---

<section id="stage-quiz" class="stage-card" style="display: none;" aria-labelledby="quiz-question-text">
  <!-- Top Bar -->
  <div class="quiz-top-bar">
    <div class="quiz-progress-info">
      <span class="quiz-step-label">
        Pertanyaan <strong id="quiz-current-num" class="tabular-nums">1</strong> / 10
      </span>
      <div
        class="progress-bar-track"
        role="progressbar"
        aria-valuenow="1"
        aria-valuemin="1"
        aria-valuemax="10"
        aria-label="Progres Kuis"
      >
        <div id="quiz-progress-fill" class="progress-bar-fill" style="width: 10%;"></div>
      </div>
    </div>

    <div id="quiz-timer-container" class="timer-badge">
      <div id="timer-reading-indicator" class="timer-reading-badge" style="display: none;" aria-live="polite">
        <span>Baca:</span>
        <strong id="reading-countdown" class="tabular-nums">3s</strong>
      </div>
      <div id="timer-active-indicator" class="timer-active-badge" aria-live="off">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <strong id="answer-countdown" class="tabular-nums">10s</strong>
      </div>
    </div>
  </div>

  <!-- Question -->
  <div class="question-container">
    <div id="brand-pool-tag" class="pool-tag" style="display: none;">Pertanyaan Surya Nusantara</div>
    <h2 id="quiz-question-text" class="question-title">Memuat pertanyaan...</h2>
  </div>

  <!-- Answer Options -->
  <div id="quiz-options-list" class="options-container" role="radiogroup" aria-label="Pilihan Jawaban">
    <!-- Rendered dynamically -->
  </div>

  <!-- Feedback Panel -->
  <div id="quiz-feedback-panel" class="feedback-panel" style="display: none;" role="region" aria-live="assertive" aria-atomic="true">
    <div class="feedback-header">
      <div id="feedback-icon" class="feedback-icon-box"></div>
      <div class="feedback-title-box">
        <h3 id="feedback-title" class="feedback-title"></h3>
        <p id="feedback-score-gain" class="feedback-score-gain"></p>
      </div>
    </div>
    <div id="feedback-explanation" class="feedback-explanation" style="display: none;"></div>
    <button id="btn-next-question" class="btn-primary" type="button">
      <span id="btn-next-label">Lanjut ke Pertanyaan Berikutnya</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>
  </div>
</section>

<style>
  .stage-card {
    background: var(--surface-card);
    border: 1.5px solid var(--border-card);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-4);
    box-shadow: var(--card-shadow);
    animation: fadeIn 0.3s ease;
  }

  /* ── Top bar ── */
  .quiz-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .quiz-progress-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .quiz-step-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-accent);
  }

  .progress-bar-track {
    width: 100%;
    height: 7px;
    background: var(--surface-subtle);
    border-radius: 9999px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #c49a45 0%, #ffd885 100%);
    border-radius: 9999px;
    transition: width 0.3s ease;
  }

  /* ── Timer ── */
  .timer-badge { flex-shrink: 0; }

  .timer-reading-badge,
  .timer-active-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    border-radius: 9999px;
    padding: 4px 12px;
    font-weight: 700;
  }

  .timer-reading-badge {
    background: var(--surface-subtle);
    color: var(--text-accent);
    border: 1.5px solid var(--color-gold-500);
    animation: pulse 1s infinite alternate;
  }

  .timer-active-badge {
    background: var(--surface-subtle);
    color: var(--text-display);
    border: 1.5px solid var(--border-card);
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  :global(.timer-active-badge.urgent) {
    border-color: var(--color-error) !important;
    color: var(--color-error) !important;
    background: var(--color-error-bg) !important;
  }

  /* ── Question ── */
  .question-container {
    margin-bottom: var(--space-4);
    text-align: left;
  }

  .pool-tag {
    display: inline-block;
    background: var(--surface-subtle);
    border: 1px solid var(--color-gold-500);
    color: var(--text-accent);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: var(--space-2);
  }

  .question-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-display);
    letter-spacing: -0.01em;
  }

  /* ── Options (dynamic) ── */
  .options-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  :global(.quiz-option-btn) {
    width: 100%;
    min-height: 56px;
    background: var(--surface-option);
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-input);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-align: left;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, transform 0.12s;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-main);
  }

  :global(.quiz-option-btn:hover:not(:disabled)) {
    background: var(--surface-option-hover);
    border-color: var(--color-gold-500);
    transform: translateY(-1px);
  }

  :global(.quiz-option-btn:focus-visible) {
    outline: 2px solid var(--color-gold-500);
    outline-offset: 2px;
  }

  :global(.quiz-option-btn:disabled) {
    cursor: not-allowed;
  }

  :global(.quiz-option-badge) {
    width: 34px;
    height: 34px;
    background: var(--surface-subtle);
    border: 1.5px solid var(--color-gold-500);
    color: var(--text-accent);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
  }

  :global(.quiz-option-text) {
    flex: 1;
    line-height: 1.35;
    font-weight: 500;
  }

  :global(.quiz-option-btn.state-correct) {
    background: var(--color-success-bg) !important;
    border-color: var(--color-success-border) !important;
    color: var(--color-success) !important;
    font-weight: 700 !important;
  }
  :global(.quiz-option-btn.state-correct .quiz-option-badge) {
    background: var(--color-success) !important;
    color: #ffffff !important;
    border-color: var(--color-success-border) !important;
  }

  :global(.quiz-option-btn.state-wrong) {
    background: var(--color-error-bg) !important;
    border-color: var(--color-error-border) !important;
    color: var(--color-error) !important;
    font-weight: 700 !important;
  }
  :global(.quiz-option-btn.state-wrong .quiz-option-badge) {
    background: var(--color-error) !important;
    color: #ffffff !important;
    border-color: var(--color-error-border) !important;
  }

  /* ── Feedback Panel ── */
  .feedback-panel {
    margin-top: var(--space-4);
    background: var(--surface-subtle);
    border: 1.5px solid var(--border-card);
    border-radius: var(--radius-input);
    padding: var(--space-4);
    animation: fadeIn 0.25s ease;
    text-align: left;
  }

  .feedback-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .feedback-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feedback-title-box {
    display: flex;
    flex-direction: column;
  }

  .feedback-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .feedback-score-gain {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .feedback-explanation {
    font-size: 0.88rem;
    color: var(--text-main);
    line-height: 1.45;
    background: var(--surface-card);
    padding: var(--space-3);
    border-radius: var(--radius-input);
    border-left: 4px solid var(--color-gold-500);
    margin-bottom: var(--space-4);
  }

  .btn-primary {
    width: 100%;
    min-height: 48px;
    background: linear-gradient(135deg, #c49a45 0%, #9e7523 100%);
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: var(--radius-button);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(196, 154, 69, 0.3);
    transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    box-shadow: 0 6px 16px rgba(196, 154, 69, 0.4);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  @keyframes pulse { from { opacity: 0.7; } to { opacity: 1; } }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
</style>
